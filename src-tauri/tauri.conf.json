{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MioProxy",
  "version": "0.1.0",
  "identifier": "dev.MioProxy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MioProxy",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 650,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/mihomo"]
  }
}
